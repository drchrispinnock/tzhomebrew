
  post_install_steps do
    mkdir_p "log/octez", base: :var
  end

  service do
    run [opt_libexec/"@NAME@-service"]
    environment_variables XDG_DATA_DIRS: "#{HOMEBREW_PREFIX}/share"
    keep_alive successful_exit: false
    throttle_interval 10
    stop_timeout 300
    log_path var/"log/octez/@NAME@.log"
    error_log_path var/"log/octez/@NAME@.log"
  end
