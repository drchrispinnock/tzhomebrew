#!/bin/sh
# launchd wrapper for octez-node. Installed by the octez-node formula.
PREFIX="@HOMEBREW_PREFIX@"
CONF="$PREFIX/etc/octez/octez-node.conf"

DATADIR="$HOME/.tezos-node"
RUNTIME_OPTS=""
[ -f "$CONF" ] && . "$CONF"

cd "$HOME" || exit 1
# shellcheck disable=SC2086
exec "$PREFIX/bin/octez-node" run --data-dir "$DATADIR" $RUNTIME_OPTS
